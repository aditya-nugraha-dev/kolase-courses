# ===== KOLASE Root .gitignore - aman untuk push GitHub + auto-deploy Vercel =====

# Dependencies
node_modules/
web/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build
web/.next/
web/out/
web/build/
coverage/

# Env - JANGAN PERNAH commit (isi manual di Vercel > Env Vars)
.env
.env.local
.env.*.local
web/.env
web/.env.local
web/.env.*.local

# Upload lokal (dev only)
web/public/uploads/
uploads/

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
web/next-env.d.ts

# OS / editor
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/

# Sementara: jangan push bahan mentah besar ke GitHub (pakai Drive link saja)
# Hapus tanda # di bawah kalau folder bahan terlalu besar (>100MB) dan bikin push gagal:
# bahan/poster/
# bahan/*.mp4
# *.mp4
